# ============================================================================
# dsh-go-gateway-fix —— DSH (cordis.patch.yml) 接线片段
#
# 用途：把 DSH 里指向 OpenCode Go 网关的 provider 改走本地修复代理。
# 位置：~/.dsh/profiles/<profile>/cordis.patch.yml   （Windows 为
#       C:\Users\<你>\.dsh\profiles\desktop\cordis.patch.yml）
#
# 本文件是「片段」，不是完整配置：请把下面 - id: llm-pi-ai 那一节合并进你
# 现有文件里同 id 的条目（DSH 的 patch 层按 id 覆盖，同 id 只保留一份）。
#
# ⚠️ 改之前先备份。Windows 上一键接线/还原用：
#      pwsh -File scripts\dsh-wire.ps1            # 接线（自动备份）
#      pwsh -File scripts\dsh-wire.ps1 -Restore   # 还原
# ============================================================================

- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      # 这条路由就是「OpenCode Go 上的 DeepSeek V4.1 Flash」。
      # 注意：DSH 内置的 27 个模型目录里没有它，所以必须自带
      # api / baseURL / models 三件套，不能省。
      opencode-go-ds41:
        displayName: OpenCode Go · DeepSeek 4.1
        apiKeyEnv: OPENCODE_API_KEY
        api: openai-completions

        # ★ 关键的一行：从官方网关改指向本地修复代理。
        #   原值：https://opencode.ai/zen/go/v1
        #   代理会原样转发到官方网关，只在必要时改写 content。
        baseURL: http://127.0.0.1:8899/zen/go/v1

        headers:
          # Go 网关要求每个请求带会话标识，缺了会 400 MissingSessionID。
          # 若你装了会在运行时注入该头的插件，可删掉这一行。
          x-opencode-session: dsh-opencode-go

        # 这五项是从 pi-ai 目录里 deepseek-v4-flash 那条照抄的，不能省：
        # 省了的话端点探测会猜错（默认按 developer 角色发系统提示、带 store
        # 参数、用 max_completion_tokens 限输出），DeepSeek 系网关不吃这套，
        # 推理内容也接不回来。
        compat:
          supportsStore: false
          supportsDeveloperRole: false
          maxTokensField: max_tokens
          requiresReasoningContentOnAssistantMessages: true
          thinkingFormat: deepseek

        models:
          - id: deepseek-v4.1-flash
            name: DeepSeek V4.1 Flash
            contextWindow: 1000000
            maxTokens: 384000
            reasoningEfforts:
              # 可选：off 档会被塞进 thinking.type。
              # 实测 Go 网关下 thinking:{type:"disabled"} → 正文 779 字、思考 0 字；
              # 默认档下思考能吃掉 10584 字、正文只剩 246 字，甚至只剩空正文
              # （官方 issue #37635）。想让代理少干点活，用这一档最省事。
              off: disabled
              low: low
              high: high
              max: max

# ----------------------------------------------------------------------------
# 回滚（二选一）
#
# 1) 只把 baseURL 改回官方地址：
#      baseURL: https://opencode.ai/zen/go/v1
#    改完 DSH 会热重载，无需重启。
#
# 2) 整段删掉，恢复到你备份的那一版。
#
# 代理进程可以继续留着跑，不影响任何其它路由（非 /zen/go/v1/ 前缀的路径
# 纯透传，且它只监听 127.0.0.1）。
# ----------------------------------------------------------------------------
